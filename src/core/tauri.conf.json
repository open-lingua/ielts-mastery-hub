{
  "productName": "ielts-mastery-hub",
  "version": "1.3.1-rc.2",
  "identifier": "com.openlingua.ieltsmasteryhub",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.imh/**"
        ]
      }
    },
    "windows": [
      {
        "title": "IELTS Mastery Hub",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "src/database/seeds/reading": "seeds/reading",
      "src/database/seeds/listening": "seeds/listening",
      "src/database/seeds/writing": "seeds/writing"
    }
  }
}
