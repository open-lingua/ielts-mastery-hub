{
  "productName": "ielts-mastery-hub",
  "version": "0.1.0",
  "identifier": "com.openlingua.ieltsmasteryhub",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.ielts-hub/**"]
      }
    },
    "windows": [
      {
        "title": "IELTS Mastery Hub",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
